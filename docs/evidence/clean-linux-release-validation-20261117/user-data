#cloud-config
users: []
disable_root: true
ssh_pwauth: false
package_update: false
package_upgrade: false
write_files:
  - path: /usr/local/sbin/agentbrake-phase.py
    permissions: '0700'
    content: |
      import json,pathlib,subprocess,traceback,os,time,selectors,signal
      P=pathlib.Path;root=P('/opt/agentbrake');proxy='http://10.0.2.2:8877'
      r={'scope':'Separate Ubuntu guest; synthetic product/isolation/restore/candidate/security checks','commands':[],'reports':{},'releaseAcceptance':False}
      env={**os.environ,'PATH':'/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin','HTTP_PROXY':proxy,'HTTPS_PROXY':proxy,'http_proxy':proxy,'https_proxy':proxy,'NO_PROXY':'localhost,127.0.0.1,::1','no_proxy':'localhost,127.0.0.1,::1','NEXT_TELEMETRY_DISABLED':'1','DEBIAN_FRONTEND':'noninteractive'}
      def emit(v):
       with open('/dev/ttyS0','w') as f:f.write('\nAGENTBRAKE_PROGRESS='+json.dumps(v)+'\n')
      def run(label,args,timeout=1800,asRoot=False):
       emit({'starting':label});at=time.monotonic()
       p=subprocess.Popen(args if asRoot else ['runuser','-u','abvalidation','--',*args],stdout=subprocess.PIPE,stderr=subprocess.STDOUT,env=env,cwd=root,start_new_session=True)
       output=bytearray();selector=selectors.DefaultSelector();selector.register(p.stdout,selectors.EVENT_READ);last=at
       failure=None;code=None
       try:
        while selector.get_map():
         if time.monotonic()-at>timeout:raise TimeoutError(label+' deadline')
         for key,_ in selector.select(1):
          chunk=os.read(key.fd,65536)
          if chunk:output.extend(chunk)
          else:selector.unregister(key.fileobj)
         if len(output)>20*1024*1024:raise RuntimeError(label+' output limit')
         if time.monotonic()-last>=30:
          emit({'running':label,'seconds':round(time.monotonic()-at),'outputBytes':len(output)});last=time.monotonic()
        code=p.wait(timeout=10)
       except Exception as error:failure=str(error)
       finally:
        selector.close()
        if p.poll() is None:
         os.killpg(p.pid,signal.SIGTERM)
         try:p.wait(timeout=10)
         except subprocess.TimeoutExpired:os.killpg(p.pid,signal.SIGKILL);p.wait(timeout=5)
       text=output.decode(errors='replace');P('/var/lib/agentbrake-validation/'+label+'.log').write_text(text)
       r['commands'].append({'label':label,'exitCode':code,'failure':failure,'seconds':round(time.monotonic()-at,2),'outputTail':text[-16000:]});emit({'finished':label,'exitCode':code})
       if failure or code:raise RuntimeError(label+' failed'+(': '+failure if failure else ''))
       return text.strip()
      try:
       import hashlib,tarfile,io,base64,gzip
       r['sourceHash']=run('exact-source',['node','--input-type=module','-e',"import {sourceManifest} from './scripts/source-manifest.mjs';console.log((await sourceManifest()).sourceHash)"])
       assert r['sourceHash']=='52f0a7bfad1233158e2e40256165fbe217ef14f8c320f3da0711668d72a6528b'
       r['previousCompleted']={}
       for name in ['service','enterprise']:
        pointer=json.loads((root/('docs/evidence/latest-'+name+'.json')).read_text());d=(root/pointer['directory']).resolve();summary=json.loads((d/(name+'-summary.json')).read_text());assert summary['sourceHash']==r['sourceHash'];r['previousCompleted'][name]=summary
       assert r['previousCompleted']['service']['result']=='PASS_LOCAL_SERVICE' and r['previousCompleted']['enterprise']['result']=='PASS_LOCAL_INSTALLED_ENTERPRISE'
       assert run('guard-active',['systemctl','is-active','ab-dependency-guard'])=='active'
       probe=root/'.agentbrake-local/scanner-bind-probe.mjs';assert not probe.exists();probe.write_text("import {mkdtemp,rm} from 'node:fs/promises';import {readFileSync} from 'node:fs';import {resolve} from 'node:path';import {spawnSync} from 'node:child_process';\nconst mode=process.argv[2],dir=await mkdtemp(resolve('.agentbrake-local/scanner-bind-probe-')),scanner=JSON.parse(readFileSync('infra/security/trivy.lock.json')).image;\ntry{const r=spawnSync('docker',['--config',resolve('.agentbrake-local/docker-public'),'run','--rm','--network','none','--read-only','--cap-drop','ALL','--security-opt','no-new-privileges:true',...(mode==='operator'?['--user',`${process.getuid()}:${process.getgid()}`]:[]),'--mount','type=bind,src='+resolve('.agentbrake-local/trivy-cache/db/metadata.json')+',dst=/db-metadata,readonly','--mount','type=bind,src='+dir+',dst=/output','--entrypoint','sh',scanner,'-c','id; cat /db-metadata >/dev/null && touch /output/report-probe'],{encoding:'utf8',timeout:30000});console.log(JSON.stringify({mode,operatorUid:process.getuid(),operatorGid:process.getgid(),exitCode:r.status,out:r.stdout,err:r.stderr}));if(mode==='operator'?r.status!==0:r.status===0||!r.stderr.includes('Permission denied'))process.exitCode=1;}finally{await rm(dir,{recursive:true});}\n");os.chown(probe,1100,1100)
       run('scanner-bind-before',['node','.agentbrake-local/scanner-bind-probe.mjs','original'],60)
       change=json.loads('{"before": "cc3ce179c4466c8f937fee38127151b04a067cb65cd4f6b3e894fcf74c0eb776", "after": "57c9fc8d269dd733aea03f1a5c7708f1b0677aa71ec87ea01a91bdd686053cd6", "data": ""}');p=root/'scripts/verify-images.mjs';assert hashlib.sha256(p.read_bytes()).hexdigest()==change['before'];b=root/'.agentbrake-local/verify-images-before-linux-user.mjs';assert not b.exists();b.write_bytes(p.read_bytes());data=base64.b64decode(change['data']);assert hashlib.sha256(data).hexdigest()==change['after'];p.write_bytes(data);os.chown(p,1100,1100)
       r['sourceHash']=run('patched-source',['node','--input-type=module','-e',"import {sourceManifest} from './scripts/source-manifest.mjs';console.log((await sourceManifest()).sourceHash)"])
       assert r['sourceHash']=='2ea911ddddb33d9bb2f0a6140da893dfdd416aec0c9e733211b190169f9814e0'
       run('scanner-bind-after',['node','.agentbrake-local/scanner-bind-probe.mjs','operator'],60)
       run('current-candidate',['npm','run','verify:candidate'],1800)
       run('current-image-scan',['npm','run','verify:images'],1800)
       r['failures']=[]
       try:run('full-release',['npm','run','verify:release'],7200)
       except Exception as e:r['failures'].append({'label':'full-release','error':str(e)})
       if not r['failures']:
        # Release rebuilt its own candidate. Rebind the scan to those actual image IDs.
        try:run('final-image-scan',['npm','run','verify:images'],1800)
        except Exception as e:r['failures'].append({'label':'final-image-scan','error':str(e)})
       else:
        try:run('current-security',['npm','run','verify:security'],1800)
        except Exception as e:r['failures'].append({'label':'current-security','error':str(e)})
       try:run('production-assessment',['npm','run','verify:production'],120)
       except Exception as e:r['assessmentExit']=r['commands'][-1]['exitCode']
       r['result']='COMPLETED_WITH_RECORDED_GATE_RESULTS'
      except Exception as e:r['result']='FAIL';r['error']=str(e);r['trace']=traceback.format_exc()
      finally:
       r['reports']={};files={}
       for prior in r.get('previousCompleted',{}).values():
        d=root/'docs/evidence'/prior['runId']
        for p in d.iterdir():
         if p.is_file() and p.suffix in ['.json','.log'] and p.stat().st_size<3*1024*1024:files[d.name+'/'+p.name]=p
       for name,filename in [('isolation','isolation-summary.json'),('product','product-summary.json'),('service','service-summary.json'),('candidate','candidate-summary.json'),('security','security-summary.json'),('enterprise','enterprise-summary.json'),('native','summary.json')]:
        pointer=root/('docs/evidence/latest'+('' if name=='native' else '-'+name)+'.json')
        if pointer.exists():
         data=json.loads(pointer.read_text());directory=(root/data['directory']).resolve();assert directory.is_relative_to(root/'docs/evidence')
         summary=directory/filename
         if summary.exists():r['reports'][name]=json.loads(summary.read_text())
         for p in directory.rglob('*'):
          if p.is_file() and p.suffix in ['.log','.json','.jsonl'] and p.stat().st_size<3*1024*1024:files[directory.name+'/'+p.relative_to(directory).as_posix()]=p
       for name in ['container-scan.json','local-release.json','production-readiness.json','milestone-b.json']:
        p=root/'docs/evidence'/name
        if p.exists():r['reports'][name]=json.loads(p.read_text());files['aggregate/'+name]=p
       for summary in [r['reports'].get('container-scan.json',{})]:
        if summary.get('runId'):
         d=root/'docs/evidence'/summary['runId']
         for p in d.glob('*.json'):
          if p.stat().st_size<3*1024*1024:files[d.name+'/'+p.name]=p
       out=io.BytesIO()
       with tarfile.open(fileobj=out,mode='w') as tar:
        for name,p in files.items():tar.add(p,arcname=name,recursive=False)
       blob=out.getvalue();assert len(blob)<15*1024*1024
       r['nativeArtifactTransfer']={'sha256':hashlib.sha256(blob).hexdigest(),'bytes':len(blob),'files':len(files)}
       P('/var/lib/agentbrake-validation/release-validation.json').write_text(json.dumps(r))
       with open('/dev/ttyS0','w') as f:
        f.write('\nAGENTBRAKE_NATIVE_EVIDENCE='+base64.b64encode(blob).decode()+'\n')
        f.write('\nAGENTBRAKE_PHASE_REPORT_GZIP='+base64.b64encode(gzip.compress(json.dumps(r).encode())).decode()+'\n')

runcmd:
  - [python3, /usr/local/sbin/agentbrake-phase.py]
power_state:
  mode: poweroff
  delay: now
  timeout: 30
  condition: true
