#cloud-config
users: []
disable_root: true
ssh_pwauth: false
package_update: false
package_upgrade: false
write_files:
  - path: /usr/local/sbin/agentbrake-phase.py
    permissions: '0700'
    content: |
      import pathlib,subprocess,json,os,base64,hashlib,traceback,time
      items=[{'path': 'scripts/product.mjs', 'beforeSha256': 'b09cb004a46565eac4faab98079c9fc0cd0e31f3857a0f833d03888a2151e26f', 'sha256': 'a8e20b5c35b606b67c538d896f99466085fe5152b6d1086846251940c4fdc683', 'content': ''}, {'path': 'scripts/fixture-file-access.mjs', 'beforeSha256': 'b06d76578c29348279e7c781c70bc1c46ab77364c57b65f9a1e88262370e9573', 'sha256': 'b612b435b1d3b2589f5eafe61a9d5c31e1b895509a51b6c04291511d150b1225', 'content': ''}, {'path': 'infra/product/compose.yaml', 'beforeSha256': 'd5f6a0285abd525ee3e1818d657c99cd62a6540ae6372e6aaf65de51f3cc56b3', 'sha256': '2368f95ea5cf421b9fa74cf5bcb386dc267ac1e79122952560f5df2198266a3f', 'content': ''}, {'path': 'infra/product/github.compose.yaml', 'beforeSha256': '97aa15232920fed3f3bb1ede145af309ba582ed3b24ddb5572e46a3c23265a1b', 'sha256': '7153bc4c7a8d284b1bb5da1af922f27893d9ad2170ca815fec1fde2a09b662d7', 'content': ''}, {'path': 'infra/product/enterprise.compose.yaml', 'beforeSha256': 'c8f232f381f83342b7c6702ec8527d51cfa99bf770e10812e90337cfb561d974', 'sha256': '13eb855eada379bf3f3aad78166d8ad62a9f11558d12c0d51ebdaada4317bf91', 'content': ''}, {'path': 'tests/enforcement/product-file-access.test.mjs', 'beforeSha256': None, 'sha256': '874bbe3df8c9da36f1aeff573a24f9dadb90f416fa1f6c83442a3ea442254093', 'content': ''}]
      expected='1ebb20fdfb823e94ccc22564efe978130a8903e108399c88a3f60099e89aa909'
      P=pathlib.Path;root=P('/opt/agentbrake');r={'scope':'Demonstrated Linux runtime secret-read permission repair; no target/network access','expectedSource':expected,'commands':[]}
      def emit(v):
       with open('/dev/ttyS0','w') as f:f.write('\nAGENTBRAKE_PROGRESS='+json.dumps(v)+'\n')
      def run(label,args,timeout=180):
       emit({'starting':label});at=time.monotonic()
       p=subprocess.run(['runuser','-u','abvalidation','--',*args],cwd=root,capture_output=True,text=True,timeout=timeout)
       output=p.stdout+p.stderr;P('/var/lib/agentbrake-validation/'+label+'.log').write_text(output)
       r['commands'].append({'label':label,'exitCode':p.returncode,'seconds':time.monotonic()-at,'outputTail':output[-14000:]});emit({'finished':label,'exitCode':p.returncode})
       if p.returncode:raise RuntimeError(label+' failed')
       return p.stdout.strip()
      try:
       assert all(n.name in ['lo','docker0'] for n in P('/sys/class/net').iterdir())
       for item in items:
        p=root/item['path'];assert p.resolve().is_relative_to(root) and not p.is_symlink()
        actual=hashlib.sha256(p.read_bytes()).hexdigest() if p.exists() else None
        assert actual in [item['beforeSha256'],item['sha256']],item['path']+' changed unexpectedly'
       backup=root/'.agentbrake-local/permission-patch-originals';assert not backup.exists();backup.mkdir(mode=0o700)
       for item in items:
        p=root/item['path'];saved=backup/item['path'];saved.parent.mkdir(parents=True,exist_ok=True)
        if p.exists():saved.write_bytes(p.read_bytes())
        data=base64.b64decode(item['content']);assert hashlib.sha256(data).hexdigest()==item['sha256']
        p.write_bytes(data);p.chmod(0o644);os.chown(p,1100,1100)
       r['sourceHash']=run('patched-source',['/usr/local/bin/node','--input-type=module','-e',"import {sourceManifest} from './scripts/source-manifest.mjs'; console.log((await sourceManifest()).sourceHash)"])
       assert r['sourceHash']==expected
       run('product-access-green',['/usr/local/bin/node','--test','tests/enforcement/product-file-access.test.mjs','tests/enforcement/fixture-file-access.test.mjs'])
       run('patched-native-stage1',['/usr/local/bin/node','scripts/verify-stage1.mjs'],1800)
       pointer=json.loads((root/'docs/evidence/latest.json').read_text());r['nativePointer']=pointer
       d=root/pointer['directory'];r['nativeSummary']=json.loads((d/'summary.json').read_text());r['nodeTestTail']=(d/'node-tests.log').read_text()[-14000:]
       assert r['nativeSummary']['sourceHash']==expected and r['nativeSummary']['result']=='PASS_SCOPED'
       r['result']='PASS_PATCHED_LINUX_NATIVE_AND_ACCESS_REGRESSION'
      except Exception as e:r['result']='FAIL';r['error']=str(e);r['trace']=traceback.format_exc()
      finally:
       P('/var/lib/agentbrake-validation/permission-patch.json').write_text(json.dumps(r))
       with open('/dev/ttyS0','w') as f:f.write('\nAGENTBRAKE_PHASE_REPORT='+json.dumps(r)+'\n')

runcmd:
  - [python3, /usr/local/sbin/agentbrake-phase.py]
power_state:
  mode: poweroff
  delay: now
  timeout: 30
  condition: true
