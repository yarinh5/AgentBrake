#cloud-config
users: []
disable_root: true
ssh_pwauth: false
package_update: false
package_upgrade: false
write_files:
  - path: /usr/local/sbin/agentbrake-phase.py
    permissions: '0700'
    content: |
      import json,pathlib,subprocess,traceback,os,time,selectors,signal
      P=pathlib.Path;root=P('/opt/agentbrake');proxy='http://10.0.2.2:8877'
      r={'scope':'Separate Ubuntu guest; synthetic product/isolation/restore/candidate/security checks','commands':[],'reports':{},'releaseAcceptance':False}
      env={**os.environ,'PATH':'/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin','HTTP_PROXY':proxy,'HTTPS_PROXY':proxy,'http_proxy':proxy,'https_proxy':proxy,'NO_PROXY':'localhost,127.0.0.1,::1','no_proxy':'localhost,127.0.0.1,::1','NEXT_TELEMETRY_DISABLED':'1','DEBIAN_FRONTEND':'noninteractive'}
      def emit(v):
       with open('/dev/ttyS0','w') as f:f.write('\nAGENTBRAKE_PROGRESS='+json.dumps(v)+'\n')
      def run(label,args,timeout=1800,asRoot=False):
       emit({'starting':label});at=time.monotonic()
       p=subprocess.Popen(args if asRoot else ['runuser','-u','abvalidation','--',*args],stdout=subprocess.PIPE,stderr=subprocess.STDOUT,env=env,cwd=root,start_new_session=True)
       output=bytearray();selector=selectors.DefaultSelector();selector.register(p.stdout,selectors.EVENT_READ);last=at
       failure=None;code=None
       try:
        while selector.get_map():
         if time.monotonic()-at>timeout:raise TimeoutError(label+' deadline')
         for key,_ in selector.select(1):
          chunk=os.read(key.fd,65536)
          if chunk:output.extend(chunk)
          else:selector.unregister(key.fileobj)
         if len(output)>20*1024*1024:raise RuntimeError(label+' output limit')
         if time.monotonic()-last>=30:
          emit({'running':label,'seconds':round(time.monotonic()-at),'outputBytes':len(output)});last=time.monotonic()
        code=p.wait(timeout=10)
       except Exception as error:failure=str(error)
       finally:
        selector.close()
        if p.poll() is None:
         os.killpg(p.pid,signal.SIGTERM)
         try:p.wait(timeout=10)
         except subprocess.TimeoutExpired:os.killpg(p.pid,signal.SIGKILL);p.wait(timeout=5)
       text=output.decode(errors='replace');P('/var/lib/agentbrake-validation/'+label+'.log').write_text(text)
       r['commands'].append({'label':label,'exitCode':code,'failure':failure,'seconds':round(time.monotonic()-at,2),'outputTail':text[-16000:]});emit({'finished':label,'exitCode':code})
       if failure or code:raise RuntimeError(label+' failed'+(': '+failure if failure else ''))
       return text.strip()
      try:
       import hashlib,base64,gzip
       prior=P('/var/lib/agentbrake-validation/product-repair.json').read_bytes();packed=gzip.compress(prior)
       with open('/dev/ttyS0','w') as f:f.write('\nAGENTBRAKE_PRIOR_REPORT_GZIP='+base64.b64encode(packed).decode()+'\n')
       r['priorReport']={'sha256':hashlib.sha256(prior).hexdigest(),'bytes':len(prior),'compressedBytes':len(packed)}
       r['sourceHash']=run('exact-source',['node','--input-type=module','-e',"import {sourceManifest} from './scripts/source-manifest.mjs';console.log((await sourceManifest()).sourceHash)"])
       assert r['sourceHash']=='8710c17580dd07e7dfe96e0894505a75026825daadcf86aa010b10463045115c'
       for filename,content in [('diagnose-service-loader.mjs','import {registerHooks} from \'node:module\';\nregisterHooks({load(url,context,next){const out=next(url,context);if(url.endsWith(\'/scripts/product.mjs\')){let source=String(out.source);const needle=\'if (code !== 0)\';if(!source.includes(needle))throw Error(\'Diagnostic anchor missing\');source="import {failureDiagnostics as diagnose} from \'./ci-failure-diagnostics.mjs\';\\n"+source.replace(needle,`if(code!==0)console.error(\'AB_DOCKER_DIAGNOSTIC=\'+JSON.stringify({verbs:args.filter(a=>[\'exec\',\'run\',\'up\',\'build\',\'snapshot\',\'restore\'].includes(a)),...diagnose(\'container-logs\',errorOutput),knownErrors:[\'Invalid volume snapshot\',\'Unsupported volume entry\',\'Volume size limit exceeded\',\'Volume snapshot size limit exceeded\',\'Restore requires an empty real volume\'].filter(s=>errorOutput.includes(s))}));\\n`+needle);return {...out,source};}return out;}});\n'),('diagnose-enterprise-access.mjs','import {mkdtemp,writeFile,stat,rm} from \'node:fs/promises\';import {resolve} from \'node:path\';import {spawnSync} from \'node:child_process\';import {readFile} from \'node:fs/promises\';\nconst dir=await mkdtemp(resolve(\'.agentbrake-local/enterprise-access-probe-\'));const image=JSON.parse(await readFile(\'infra/local/images.lock.json\',\'utf8\')).images.node.image;\ntry{await writeFile(dir+\'/enterprise-fixture.json\',\'{}\',{mode:0o600});const out=spawnSync(\'docker\',[\'--config\',resolve(\'.agentbrake-local/docker-public\'),\'run\',\'--rm\',\'--network\',\'none\',\'--read-only\',\'--cap-drop\',\'ALL\',\'--security-opt\',\'no-new-privileges:true\',\'--user\',\'1000:1000\',\'--mount\',\'type=bind,src=\'+dir+\'/enterprise-fixture.json,dst=/run/secrets/enterprise-fixture.json,readonly\',image,\'node\',\'-e\',"try{require(\'fs\').readFileSync(\'/run/secrets/enterprise-fixture.json\');console.log(\'READ_OK\')}catch(e){console.log(JSON.stringify({code:e.code,path:e.path}));process.exit(13)}"],{encoding:\'utf8\',timeout:30000});console.log(JSON.stringify({operatorUid:process.getuid(),operatorGid:process.getgid(),fileMode:(await stat(dir+\'/enterprise-fixture.json\')).mode&511,configuredFixtureUser:\'1000:1000\',configuredSupplementaryGroups:[],exitCode:out.status,output:out.stdout}));if(out.status!==13)process.exitCode=1;}finally{await rm(dir,{recursive:true});}\n')]:
        p=root/'.agentbrake-local'/filename;assert not p.exists();p.write_text(content);os.chown(p,1100,1100)
       r['failures']=[]
       for label,cmd in [('enterprise-access-cause',['node','.agentbrake-local/diagnose-enterprise-access.mjs']),('service-diagnostic',['node','--import','./.agentbrake-local/diagnose-service-loader.mjs','scripts/verify-service.mjs']),('security-documented-entry',['npm','run','verify:security'])]:
        try:run(label,cmd,1800)
        except Exception as e:r['failures'].append({'label':label,'error':str(e)})
       r['result']='DIAGNOSTIC_COMPLETED_NOT_RELEASE'
      except Exception as e:r['result']='FAIL';r['error']=str(e);r['trace']=traceback.format_exc()
      finally:
       P('/var/lib/agentbrake-validation/failure-diagnostics.json').write_text(json.dumps(r))
       with open('/dev/ttyS0','w') as f:f.write('\nAGENTBRAKE_PHASE_REPORT='+json.dumps(r)+'\n')

runcmd:
  - [python3, /usr/local/sbin/agentbrake-phase.py]
power_state:
  mode: poweroff
  delay: now
  timeout: 30
  condition: true
