    permissions: '0700'
    content: |
      import json,pathlib,subprocess,traceback,os,time,selectors,signal
      P=pathlib.Path;root=P('/opt/agentbrake');proxy='http://10.0.2.2:8877'
      r={'scope':'Separate Ubuntu guest; synthetic product/isolation/restore/candidate/security checks','commands':[],'reports':{},'releaseAcceptance':False}
      env={**os.environ,'PATH':'/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin','HTTP_PROXY':proxy,'HTTPS_PROXY':proxy,'http_proxy':proxy,'https_proxy':proxy,'NO_PROXY':'localhost,127.0.0.1,::1','no_proxy':'localhost,127.0.0.1,::1','NEXT_TELEMETRY_DISABLED':'1','DEBIAN_FRONTEND':'noninteractive'}
      def emit(v):
       with open('/dev/ttyS0','w') as f:f.write('\nAGENTBRAKE_PROGRESS='+json.dumps(v)+'\n')
      def run(label,args,timeout=1800,asRoot=False):
       emit({'starting':label});at=time.monotonic()
       p=subprocess.Popen(args if asRoot else ['runuser','-u','abvalidation','--',*args],stdout=subprocess.PIPE,stderr=subprocess.STDOUT,env=env,cwd=root,start_new_session=True)
       output=bytearray();selector=selectors.DefaultSelector();selector.register(p.stdout,selectors.EVENT_READ);last=at
       failure=None;code=None
       try:
        while selector.get_map():
         if time.monotonic()-at>timeout:raise TimeoutError(label+' deadline')
         for key,_ in selector.select(1):
          chunk=os.read(key.fd,65536)
          if chunk:output.extend(chunk)
          else:selector.unregister(key.fileobj)
         if len(output)>20*1024*1024:raise RuntimeError(label+' output limit')
         if time.monotonic()-last>=30:
          emit({'running':label,'seconds':round(time.monotonic()-at),'outputBytes':len(output)});last=time.monotonic()
        code=p.wait(timeout=10)
       except Exception as error:failure=str(error)
       finally:
        selector.close()
        if p.poll() is None:
         os.killpg(p.pid,signal.SIGTERM)
         try:p.wait(timeout=10)
         except subprocess.TimeoutExpired:os.killpg(p.pid,signal.SIGKILL);p.wait(timeout=5)
       text=output.decode(errors='replace');P('/var/lib/agentbrake-validation/'+label+'.log').write_text(text)
       r['commands'].append({'label':label,'exitCode':code,'failure':failure,'seconds':round(time.monotonic()-at,2),'outputTail':text[-16000:]});emit({'finished':label,'exitCode':code})
       if failure or code:raise RuntimeError(label+' failed'+(': '+failure if failure else ''))
       return text.strip()
      try:
       import hashlib,tarfile,io,base64,gzip,uuid
       r['sourceHash']=run('exact-source',['node','--input-type=module','-e',"import {sourceManifest} from './scripts/source-manifest.mjs';console.log((await sourceManifest()).sourceHash)"])
       assert r['sourceHash']=='0d00cd87460a49e11cfb36a183fd353ad482942ee88becbb4065067017f9aa49'
       assert run('guard-active',['systemctl','is-active','ab-dependency-guard'])=='active'
       lock=json.loads((root/'infra/local/codex.lock.json').read_text());cache=root/'.tools/ollama-models';target=cache/'blobs'/('sha256-'+lock['model']['expectedRegistryManifestSha256']);link=cache/'manifests-v2/ollama.com/library/qwen3/4b-instruct';assert target.is_file();assert hashlib.sha256(target.read_bytes()).hexdigest()==lock['model']['expectedRegistryManifestSha256'];assert not (cache/'manifests-v2').exists()
       docker=['docker','--config',str(root/'.agentbrake-local/docker-public')]
       def probe(mode):
        name='agentbrake-model-layout-'+uuid.uuid4().hex[:8]
        try:
         run('layout-'+mode+'-start',docker+['run','-d','--name',name,'--label','com.agentbrake.fixture=true','--network','none','--read-only','--cap-drop','ALL','--security-opt','no-new-privileges:true','--user','1000:1000','--memory','512m','--pids-limit','256','--tmpfs','/tmp:size=256m,mode=1777','--mount','type=bind,src='+str(cache)+',dst=/models,readonly','--env','HOME=/tmp','--env','OLLAMA_MODELS=/models','--env','OLLAMA_NO_CLOUD=1',lock['ollama']['image'],'serve'],60)
         for attempt in range(20):
          p=subprocess.run(['runuser','-u','abvalidation','--',*docker,'exec','--env','OLLAMA_HOST=http://127.0.0.1:11434','--env','HTTP_PROXY=','--env','HTTPS_PROXY=','--env','http_proxy=','--env','https_proxy=',name,'ollama','list'],capture_output=True,text=True,env=env,timeout=15)
          out=p.stdout+p.stderr
          if 'could not connect' not in out.lower() and 'connection refused' not in out.lower():break
          time.sleep(1)
         result={'exitCode':p.returncode,'output':out,'mode':mode,'network':'none','cache':'read-only','image':lock['ollama']['image']};r.setdefault('modelLayout',{})[mode]=result
         if mode=='before':assert p.returncode!=0 and 'read-only file system' in out,out
         else:assert p.returncode==0 and lock['model']['name'] in out,out
         emit({'modelLayout':mode,'expectedResultObserved':True})
        finally:run('layout-'+mode+'-cleanup',docker+['rm','--force',name],60)
       probe('before')
       link.parent.mkdir(parents=True)
       for d in [cache/'manifests-v2',cache/'manifests-v2/ollama.com',cache/'manifests-v2/ollama.com/library',link.parent]:os.chown(d,1100,1100);d.chmod(0o755)
       link.symlink_to('../../../../blobs/'+target.name);os.lchown(link,1100,1100);assert link.resolve()==target.resolve() and link.resolve().is_relative_to(cache.resolve())
       r['modelLayout']['repair']={'link':str(link.relative_to(cache)),'target':os.readlink(link),'resolvedSha256':hashlib.sha256(link.read_bytes()).hexdigest(),'cause':'Curated offline transfer omitted the pinned runtime v2 manifest alias. Original host cache includes this relative link; weights and source are unchanged.'}
       probe('after')
       run('model-integrity',['node','--input-type=module','-e',"import {verifyModelCache} from './scripts/verify-model-cache.mjs';import {readFile} from 'node:fs/promises';const lock=JSON.parse(await readFile('infra/local/codex.lock.json','utf8'));console.log(JSON.stringify(await verifyModelCache('.tools/ollama-models',lock.model.expectedRegistryManifestSha256)))"],120)
       r['failures']=[]
       try:run('full-release',['npm','run','verify:release'],7200)
       except Exception as e:r['failures'].append({'label':'full-release','error':str(e)})
       for name in ['product','service','enterprise']:
        pointer=root/('docs/evidence/latest-'+name+'.json');prior={}
        if pointer.exists():
         d=json.loads(pointer.read_text());prior=json.loads((root/d['directory']/(name+'-summary.json')).read_text())
        expected={'product':'PASS_LOCAL_PRODUCT','service':'PASS_LOCAL_SERVICE','enterprise':'PASS_LOCAL_INSTALLED_ENTERPRISE'}[name]
        if prior.get('sourceHash')==r['sourceHash'] and prior.get('result')==expected:
         r.setdefault('alreadyVerified',{})[name]={'runId':prior['runId'],'sourceHash':prior['sourceHash'],'result':prior['result']};continue
        try:run('current-'+name,['npm','run','verify:'+name],2400)
        except Exception as e:r['failures'].append({'label':name,'error':str(e)})
       p=root/'.agentbrake-local/enterprise-linux-restore-harness.mjs';assert not p.exists();data=base64.b64decode('');assert hashlib.sha256(data).hexdigest()=='27b05d32d2d8e2c160847184b1263ece5704ed2e762db4144e596e38eb82fa6a';p.write_bytes(data);os.chown(p,1100,1100)
       try:run('current-enterprise-restore',['node','.agentbrake-local/enterprise-linux-restore-harness.mjs'],2400)
       except Exception as e:r['failures'].append({'label':'enterprise-restore','error':str(e)})
       for label,args in [('final-image-scan',['npm','run','verify:images']),('final-security',['npm','run','verify:security'])]:
        try:run(label,args,1800)
        except Exception as e:r['failures'].append({'label':label,'error':str(e)})
       r['finalSourceHash']=run('final-source',['node','--input-type=module','-e',"import {sourceManifest} from './scripts/source-manifest.mjs';console.log((await sourceManifest()).sourceHash)"])
       assert r['sourceHash']==r['finalSourceHash']
       try:run('production-assessment',['npm','run','verify:production'],120)
       except Exception as e:r['assessmentExit']=r['commands'][-1]['exitCode']
       r['result']='COMPLETED_WITH_RECORDED_GATE_RESULTS'
      except Exception as e:r['result']='FAIL';r['error']=str(e);r['trace']=traceback.format_exc()
      finally:
       r['reports']={};files={}
       for prior in r.get('previousCompleted',{}).values():
        d=root/'docs/evidence'/prior['runId']
        for p in d.iterdir():
         if p.is_file() and p.suffix in ['.json','.log'] and p.stat().st_size<3*1024*1024:files[d.name+'/'+p.name]=p
       for name,filename in [('isolation','isolation-summary.json'),('product','product-summary.json'),('service','service-summary.json'),('candidate','candidate-summary.json'),('security','security-summary.json'),('enterprise','enterprise-summary.json'),('native','summary.json')]:
        pointer=root/('docs/evidence/latest'+('' if name=='native' else '-'+name)+'.json')
        if pointer.exists():
         data=json.loads(pointer.read_text());directory=(root/data['directory']).resolve();assert directory.is_relative_to(root/'docs/evidence')
         summary=directory/filename
         if summary.exists():r['reports'][name]=json.loads(summary.read_text())
         for p in directory.rglob('*'):
          if p.is_file() and p.suffix in ['.log','.json','.jsonl'] and p.stat().st_size<3*1024*1024:files[directory.name+'/'+p.relative_to(directory).as_posix()]=p
       for name in ['container-scan.json','local-release.json','production-readiness.json','milestone-b.json']:
        p=root/'docs/evidence'/name
        if p.exists():r['reports'][name]=json.loads(p.read_text());files['aggregate/'+name]=p
       for summary in [r['reports'].get('container-scan.json',{})]:
        if summary.get('runId'):
         d=root/'docs/evidence'/summary['runId']
         for p in d.glob('*.json'):
          if p.stat().st_size<3*1024*1024:files[d.name+'/'+p.name]=p
       for d in (root/'docs/enterprise-work').glob('restore-evidence-*'):
        p=d/'summary.json'
        if p.exists():
         summary=json.loads(p.read_text())
         if summary.get('sourceHash')==r['sourceHash']:
          r['reports']['enterprise-restore']=summary
          for name in ['summary.json','source-manifest.json','harness.mjs','harness.sha256']:
           p=d/name
           if p.exists():files['enterprise-restore/'+d.name+'/'+name]=p
       out=io.BytesIO()
       with tarfile.open(fileobj=out,mode='w') as tar:
        for name,p in files.items():tar.add(p,arcname=name,recursive=False)
       blob=out.getvalue();assert len(blob)<15*1024*1024
       r['nativeArtifactTransfer']={'sha256':hashlib.sha256(blob).hexdigest(),'bytes':len(blob),'files':len(files)}
       P('/var/lib/agentbrake-validation/model-layout-retry.json').write_text(json.dumps(r))
       with open('/dev/ttyS0','w') as f:
        f.write('\nAGENTBRAKE_NATIVE_EVIDENCE_GZIP='+base64.b64encode(gzip.compress(blob)).decode()+'\n')
        f.write('\nAGENTBRAKE_PHASE_REPORT_GZIP='+base64.b64encode(gzip.compress(json.dumps(r).encode())).decode()+'\n')

runcmd:
  - [python3, /usr/local/sbin/agentbrake-phase.py]
power_state:
  mode: poweroff
  delay: now
  timeout: 30
  condition: true
