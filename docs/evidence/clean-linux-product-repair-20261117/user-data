#cloud-config
users: []
disable_root: true
ssh_pwauth: false
package_update: false
package_upgrade: false
write_files:
  - path: /usr/local/sbin/agentbrake-phase.py
    permissions: '0700'
    content: |
      import json,pathlib,subprocess,traceback,os,time,selectors,signal
      P=pathlib.Path;root=P('/opt/agentbrake');proxy='http://10.0.2.2:8877'
      r={'scope':'Separate Ubuntu guest; synthetic product/isolation/restore/candidate/security checks','commands':[],'reports':{},'releaseAcceptance':False}
      env={**os.environ,'PATH':'/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin','HTTP_PROXY':proxy,'HTTPS_PROXY':proxy,'http_proxy':proxy,'https_proxy':proxy,'NO_PROXY':'localhost,127.0.0.1,::1','no_proxy':'localhost,127.0.0.1,::1','NEXT_TELEMETRY_DISABLED':'1','DEBIAN_FRONTEND':'noninteractive'}
      def emit(v):
       with open('/dev/ttyS0','w') as f:f.write('\nAGENTBRAKE_PROGRESS='+json.dumps(v)+'\n')
      def run(label,args,timeout=1800,asRoot=False):
       emit({'starting':label});at=time.monotonic()
       p=subprocess.Popen(args if asRoot else ['runuser','-u','abvalidation','--',*args],stdout=subprocess.PIPE,stderr=subprocess.STDOUT,env=env,cwd=root,start_new_session=True)
       output=bytearray();selector=selectors.DefaultSelector();selector.register(p.stdout,selectors.EVENT_READ);last=at
       failure=None;code=None
       try:
        while selector.get_map():
         if time.monotonic()-at>timeout:raise TimeoutError(label+' deadline')
         for key,_ in selector.select(1):
          chunk=os.read(key.fd,65536)
          if chunk:output.extend(chunk)
          else:selector.unregister(key.fileobj)
         if len(output)>20*1024*1024:raise RuntimeError(label+' output limit')
         if time.monotonic()-last>=30:
          emit({'running':label,'seconds':round(time.monotonic()-at),'outputBytes':len(output)});last=time.monotonic()
        code=p.wait(timeout=10)
       except Exception as error:failure=str(error)
       finally:
        selector.close()
        if p.poll() is None:
         os.killpg(p.pid,signal.SIGTERM)
         try:p.wait(timeout=10)
         except subprocess.TimeoutExpired:os.killpg(p.pid,signal.SIGKILL);p.wait(timeout=5)
       text=output.decode(errors='replace');P('/var/lib/agentbrake-validation/'+label+'.log').write_text(text)
       r['commands'].append({'label':label,'exitCode':code,'failure':failure,'seconds':round(time.monotonic()-at,2),'outputTail':text[-16000:]});emit({'finished':label,'exitCode':code})
       if failure or code:raise RuntimeError(label+' failed'+(': '+failure if failure else ''))
       return text.strip()
      try:
       import hashlib,base64,tarfile,io
       patches=json.loads('[{"path": "infra/local/compose.yaml", "before": "a37d540dd05f62cc6e54ed814a23c31198a3a6a68a5ef8e5fadb400e6b69578b", "after": "76a57c31ea4ced8c9f5b23181c3908503b01cc95c6783f116241a7ffbb514ba2", "data": ""}, {"path": "infra/product/compose.yaml", "before": "2368f95ea5cf421b9fa74cf5bcb386dc267ac1e79122952560f5df2198266a3f", "after": "fc7afb592ae1ce2b359d1bbb80abad9668a896b34b93e90e6eda25b92389b056", "data": ""}, {"path": "infra/product/minimal.compose.yaml", "before": "07ac34803994b406bb2d6b5942a12f0a1879011e7fa684a6a788a95663401497", "after": "9f907abcdc9c7e5b6111ea99b4a6c322d85b227cda6f90af610c7b54eb94b542", "data": ""}, {"path": "tests/enforcement/compose-build-ownership.test.mjs", "before": null, "after": "cecb42bd3b4eca6b531f6c7dcf745a440ea2c856c1ebade0800787fae39f755e", "data": ""}]')
       for item in patches:
        p=root/item['path'];assert p.resolve().is_relative_to(root)
        assert (hashlib.sha256(p.read_bytes()).hexdigest() if p.exists() else None)==item['before']
       for item in patches:
        p=root/item['path'];data=base64.b64decode(item['data']);assert hashlib.sha256(data).hexdigest()==item['after']
        p.write_bytes(data);os.chown(p,1100,1100)
       r['sourceHash']=run('exact-source',['node','--input-type=module','-e',"import {sourceManifest} from './scripts/source-manifest.mjs'; console.log((await sourceManifest()).sourceHash)"])
       assert r['sourceHash']=='8710c17580dd07e7dfe96e0894505a75026825daadcf86aa010b10463045115c'
       run('build-regression',['node','--test','tests/enforcement/compose-build-ownership.test.mjs'])
       assert run('guard-active',['systemctl','is-active','ab-dependency-guard'])=='active'
       # Transfer only previously verified public model weights; no host credentials.
       subprocess.run(['mkdir','-p','/mnt/ab-model-seed'],check=True)
       subprocess.run(['mount','-o','ro','/dev/sr0','/mnt/ab-model-seed'],check=True,capture_output=True)
       archive=P('/mnt/ab-model-seed/models.tar')
       assert hashlib.file_digest(archive.open('rb'),'sha256').hexdigest()=='b7a42c2841b677191b29ffae58fdb734fad4cadd0c42a9ba7a1734fc969532f6'
       with tarfile.open(archive) as model:
        for entry in model.getmembers():
         p=P(entry.name);assert entry.isfile() and not p.is_absolute() and '..' not in p.parts and entry.name.startswith('.tools/ollama-models/')
         assert entry.uid==entry.gid==1100
        model.extractall(root,filter='data')
       for p in [root/'.tools/ollama-models',*(root/'.tools/ollama-models').rglob('*')]:os.chown(p,1100,1100)
       run('model-integrity',['node','--input-type=module','-e',"import {verifyModelCache} from './scripts/verify-model-cache.mjs';console.log(JSON.stringify(await verifyModelCache('.tools/ollama-models','0edcdef34593eac1aa2be9c7d06c432dcf81945adca5eca2f27662c18f168ba0')))"])
       r['failures']=[]
       for label,script in [('benchmark','verify-isolation.mjs'),('product','verify-product.mjs'),('service','verify-service.mjs'),('candidate','verify-candidate.mjs'),('security','verify-security.mjs'),('enterprise','verify-enterprise.mjs'),('final-native','verify-stage1.mjs')]:
        try:run(label,['node','scripts/'+script,*(['--expanded-benchmark'] if label=='benchmark' else [])],2400)
        except Exception as e:r['failures'].append({'label':label,'error':str(e)})
       r['result']='FAIL' if r['failures'] else 'PASS_SCOPED_PRODUCT_AND_NATIVE'
      except Exception as e:r['result']='FAIL';r['error']=str(e);r['trace']=traceback.format_exc()
      finally:
       r['reports']={};files={}
       for name,filename in [('isolation','isolation-summary.json'),('product','product-summary.json'),('service','service-summary.json'),('candidate','candidate-summary.json'),('security','security-summary.json'),('enterprise','enterprise-summary.json'),('native','summary.json')]:
        pointer=root/('docs/evidence/latest'+('' if name=='native' else '-'+name)+'.json')
        if pointer.exists():
         data=json.loads(pointer.read_text());directory=(root/data['directory']).resolve();assert directory.is_relative_to(root/'docs/evidence')
         summary=directory/filename
         if summary.exists():r['reports'][name]=json.loads(summary.read_text())
         for p in directory.iterdir():
          if p.is_file() and p.suffix in ['.log','.json'] and p.stat().st_size<3*1024*1024:files[directory.name+'/'+p.name]=p
       out=io.BytesIO()
       with tarfile.open(fileobj=out,mode='w') as tar:
        for name,p in files.items():tar.add(p,arcname=name,recursive=False)
       blob=out.getvalue();assert len(blob)<15*1024*1024
       r['nativeArtifactTransfer']={'sha256':hashlib.sha256(blob).hexdigest(),'bytes':len(blob),'files':len(files)}
       P('/var/lib/agentbrake-validation/product-repair.json').write_text(json.dumps(r))
       with open('/dev/ttyS0','w') as f:
        f.write('\nAGENTBRAKE_NATIVE_EVIDENCE='+base64.b64encode(blob).decode()+'\n')
        f.write('\nAGENTBRAKE_PHASE_REPORT='+json.dumps(r)+'\n')

runcmd:
  - [python3, /usr/local/sbin/agentbrake-phase.py]
power_state:
  mode: poweroff
  delay: now
  timeout: 30
  condition: true
