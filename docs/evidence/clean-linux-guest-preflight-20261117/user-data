#cloud-config
hostname: agentbrake-validation
manage_etc_hosts: true
users: []
disable_root: true
ssh_pwauth: false
package_update: false
package_upgrade: false
ssh_deletekeys: true
write_files:
  - path: /usr/local/sbin/agentbrake-guest-preflight.py
    permissions: '0755'
    content: |
      import json,os,platform,subprocess,pathlib
      def cmd(*args):return subprocess.check_output(args,text=True).strip()
      osrelease=dict(line.split('=',1) for line in pathlib.Path('/etc/os-release').read_text().splitlines() if '=' in line)
      report={'kind':'agentbrake-clean-guest-preflight','os':osrelease,'kernel':platform.release(),'architecture':platform.machine(),'cpuCount':os.cpu_count(),'memory':pathlib.Path('/proc/meminfo').read_text().splitlines()[0],'blockDevices':json.loads(cmd('lsblk','-b','-J','-o','NAME,TYPE,SIZE,MOUNTPOINTS')),'interfaces':sorted(p.name for p in pathlib.Path('/sys/class/net').iterdir()),'routes':cmd('ip','route'),'agentbrakeInstalled':False,'dockerInstalled':pathlib.Path('/usr/bin/docker').exists(),'nodeInstalled':pathlib.Path('/usr/bin/node').exists(),'rootFreeBytes':os.statvfs('/').f_bavail*os.statvfs('/').f_frsize,'cloudInitVersion':cmd('cloud-init','--version')}
      assert report['interfaces']==['lo'] and report['routes']==''
      assert osrelease['ID'].strip('"')=='ubuntu' and osrelease['VERSION_ID'].strip('"')=='24.04'
      assert report['architecture']=='x86_64'
      report['result']='PASS_OFFLINE_GUEST_PREFLIGHT_ONLY'
      pathlib.Path('/var/lib/agentbrake-validation').mkdir(exist_ok=True)
      pathlib.Path('/var/lib/agentbrake-validation/guest-preflight.json').write_text(json.dumps(report))
      with open('/dev/ttyS0','w') as serial:serial.write('\nAGENTBRAKE_GUEST_REPORT='+json.dumps(report)+'\n')

runcmd:
  - [systemctl, disable, --now, ssh.service, ssh.socket]
  - [python3, /usr/local/sbin/agentbrake-guest-preflight.py]
power_state:
  mode: poweroff
  delay: now
  timeout: 30
  condition: true
