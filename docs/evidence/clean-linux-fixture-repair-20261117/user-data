#cloud-config
users: []
disable_root: true
ssh_pwauth: false
package_update: false
package_upgrade: false
write_files:
  - path: /usr/local/sbin/agentbrake-phase.py
    permissions: '0700'
    content: |
      import pathlib,subprocess,json,os,base64,hashlib,traceback,tarfile,io
      items=[{'path': 'scripts/product.mjs', 'before': 'a8e20b5c35b606b67c538d896f99466085fe5152b6d1086846251940c4fdc683', 'after': '09ae8a9e5b1913164e2be9470203126b5283b78171f9bd4ab5c56401fa71b355', 'data': ''}, {'path': 'tests/enforcement/service-restore-orchestration.mjs', 'before': '4d3238787c060b2c04bb905c4e772f9d20ae3e1d66a427b339687be16d1fb964', 'after': '1a3d56301201bfa2cca7fdd6391c0c6ba3bc2cedfc5440a7d744e233d5afea30', 'data': ''}]
      P=pathlib.Path;root=P('/opt/agentbrake');r={'scope':'Repair incomplete simulated-start fixture; keep Linux permissions enforcement and preserve non-Linux behavior','commands':[]}
      def run(label,args):
       p=subprocess.run(['runuser','-u','abvalidation','--',*args],cwd=root,capture_output=True,text=True,timeout=180)
       r['commands'].append({'label':label,'exitCode':p.returncode,'output':(p.stdout+p.stderr)[-22000:]})
       if p.returncode:raise RuntimeError(label+' failed')
       return p.stdout.strip()
      try:
       pointer=json.loads((root/'docs/evidence/latest.json').read_text());previous=root/pointer['directory']
       r['previousNativeSummary']=json.loads((previous/'summary.json').read_text())
       assert r['previousNativeSummary']['sourceHash']=='1ebb20fdfb823e94ccc22564efe978130a8903e108399c88a3f60099e89aa909'
       log=(previous/'node-tests.log').read_text();start=log.index('not ok ');r['previousFailure']=log[max(0,start-300):start+5000];r['previousTestTail']=log[-1500:]
       baseline=json.loads(P('/var/lib/agentbrake-validation/native.json').read_text())
       archive=io.BytesIO();total=0
       with tarfile.open(fileobj=archive,mode='w:gz') as tar:
        for directory in [previous,root/baseline['nativePointer']['directory']]:
         assert directory.resolve().is_relative_to(root/'docs/evidence')
         for p in sorted(directory.iterdir()):
          if p.suffix not in ['.json','.log']:continue
          assert p.is_file() and not p.is_symlink() and p.stat().st_size<5*1024*1024
          total+=p.stat().st_size;assert total<16*1024*1024
          tar.add(p,arcname=str(p.relative_to(root/'docs/evidence')))
       blob=archive.getvalue();assert len(blob)<4*1024*1024
       r['nativeArtifactTransfer']={'bytes':len(blob),'sha256':hashlib.sha256(blob).hexdigest()}
       with open('/dev/ttyS0','w') as f:f.write('\nAGENTBRAKE_NATIVE_EVIDENCE='+base64.b64encode(blob).decode()+'\n')
       backup=root/'.agentbrake-local/fixture-repair-originals';assert not backup.exists();backup.mkdir(mode=0o700)
       for item in items:
        p=root/item['path'];assert not p.is_symlink() and p.resolve().is_relative_to(root)
        assert hashlib.sha256(p.read_bytes()).hexdigest()==item['before']
       for item in items:
        p=root/item['path'];saved=backup/item['path'];saved.parent.mkdir(parents=True,exist_ok=True);saved.write_bytes(p.read_bytes())
        data=base64.b64decode(item['data']);assert hashlib.sha256(data).hexdigest()==item['after'];p.write_bytes(data);p.chmod(0o644);os.chown(p,1100,1100)
       r['sourceHash']=run('source',['/usr/local/bin/node','--input-type=module','-e',"import {sourceManifest} from './scripts/source-manifest.mjs'; console.log((await sourceManifest()).sourceHash)"])
       assert r['sourceHash']=='fb5b65ff91880bb711f5de632f9d0cc9610232094e567dd21accaa9004606fe3'
       run('access-and-recovery',['/usr/local/bin/node','--test','tests/enforcement/product-file-access.test.mjs','tests/enforcement/fixture-file-access.test.mjs','tests/enforcement/product-recovery.test.mjs'])
       r['result']='PASS_FOCUSED_LINUX_ACCESS_AND_RECOVERY';r['fullNativeForThisSource']='NOT_RUN_YET'
      except Exception as e:r['result']='FAIL';r['error']=str(e);r['trace']=traceback.format_exc()
      finally:
       P('/var/lib/agentbrake-validation/fixture-repair.json').write_text(json.dumps(r))
       with open('/dev/ttyS0','w') as f:f.write('\nAGENTBRAKE_PHASE_REPORT='+json.dumps(r)+'\n')

runcmd:
  - [python3, /usr/local/sbin/agentbrake-phase.py]
power_state:
  mode: poweroff
  delay: now
  timeout: 30
  condition: true
