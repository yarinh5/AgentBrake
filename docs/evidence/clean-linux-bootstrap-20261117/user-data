#cloud-config
hostname: agentbrake-validation
users: []
disable_root: true
ssh_pwauth: false
package_update: false
package_upgrade: false
bootcmd:
  - [systemctl, mask, systemd-networkd-wait-online.service]
write_files:
  - path: /usr/local/sbin/agentbrake-bootstrap.py
    permissions: '0700'
    content: |
      import json,os,subprocess,pathlib,hashlib,traceback,tarfile,posixpath
      P=pathlib.Path
      report={'kind':'agentbrake-offline-development-bootstrap','releaseAcceptance':False,'networkEnabled':False,'commands':[]}
      def run(args,timeout=600):
       r=subprocess.run(args,text=True,stdout=subprocess.PIPE,stderr=subprocess.STDOUT,timeout=timeout)
       report['commands'].append({'command':args,'exitCode':r.returncode,'outputTail':r.stdout[-6000:]})
       if r.returncode:raise RuntimeError('Command failed: '+str(args))
       return r.stdout.strip()
      try:
       assert sorted(p.name for p in P('/sys/class/net').iterdir())==['lo']
       assert run(['ip','route'])==''
       P('/mnt/abseed').mkdir(exist_ok=True)
       run(['mount','-o','ro','/dev/sr0','/mnt/abseed'])
       seed=P('/mnt/abseed');catalog=json.loads((seed/'catalog.json').read_text())
       for f in catalog:
        p=seed/f['name'];assert p.stat().st_size==f['bytes']
        with p.open('rb') as stream:assert hashlib.file_digest(stream,'sha256').hexdigest()==f['sha256']
       report['verifiedPayloadCount']=len(catalog)
       # Packages were downloaded using signed Ubuntu indexes; no network fallback.
       run(['dpkg','--install',*map(str,sorted(seed.glob('*.deb')))])
       run(['dpkg','--audit'])
       run(['tar','-xf',str(seed/'node-runtime.tar'),'-C','/usr/local'])
       source=P('/opt/agentbrake');assert not source.exists();source.mkdir()
       run(['tar','-xzf',str(next(seed.glob('agentbrake-UNRELEASED-*.tar.gz'))),'-C',str(source)])
       run(['useradd','--create-home','--uid','1100','--shell','/bin/bash','abvalidation'])
       run(['usermod','-aG','docker','abvalidation'])
       run(['chown','-R','abvalidation:abvalidation',str(source)])
       run(['systemctl','enable','--now','docker'])
       report['node']=run(['/usr/local/bin/node','--version'])
       report['npm']=run(['/usr/local/bin/npm','--version'])
       report['docker']=run(['docker','version','--format','{{json .Server}}'])
       report['compose']=run(['docker','compose','version','--short'])
       report['sourceHash']=run(['/usr/local/bin/node','--input-type=module','-e',"import {sourceManifest} from '/opt/agentbrake/scripts/source-manifest.mjs'; console.log((await sourceManifest()).sourceHash)"])
       assert report['sourceHash']=='855b2915022fae9542d05207f62bec5eb356d942a001a9f3415a738f3b453c8c'
       report['interfaces']=sorted(p.name for p in P('/sys/class/net').iterdir())
       report['routes']=run(['ip','route'])
       # Docker may create its local bridge; there must be no default/physical route.
       assert 'default' not in report['routes'] and all(n=='lo' or n=='docker0' for n in report['interfaces'])
       report['result']='PASS_OFFLINE_DEVELOPMENT_TOOLCHAIN_SOURCE_ONLY'
      except Exception as e:
       report['result']='FAIL';report['error']=str(e);report['trace']=traceback.format_exc()
      finally:
       P('/var/lib/agentbrake-validation').mkdir(exist_ok=True)
       P('/var/lib/agentbrake-validation/bootstrap.json').write_text(json.dumps(report))
       with open('/dev/ttyS0','w') as serial:serial.write('\nAGENTBRAKE_BOOTSTRAP_REPORT='+json.dumps(report)+'\n')

runcmd:
  - [systemctl, disable, --now, ssh.service, ssh.socket]
  - [python3, /usr/local/sbin/agentbrake-bootstrap.py]
power_state:
  mode: poweroff
  delay: now
  timeout: 30
  condition: true
