{
  "name": "agentbrake",
  "version": "0.3.0-rc.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/local.mjs",
    "setup": "node scripts/install-opa.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node scripts/local.mjs --built",
    "test": "node scripts/test.mjs",
    "setup:policy": "node scripts/install-opa.mjs",
    "test:ui": "node tests/product-ui/run.mjs",
    "verify:stage1": "node scripts/verify-stage1.mjs",
    "verify:isolation": "node scripts/verify-isolation.mjs",
    "mcp": "tsx server/mcp.ts",
    "verify:stage2": "node scripts/verify-isolation.mjs",
    "verify:full": "node scripts/verify-all.mjs",
    "setup:codex-local": "node scripts/setup-codex-local.mjs",
    "verify:milestone-b": "node scripts/verify-all.mjs --milestone-b",
    "product:init": "node scripts/product.mjs init",
    "product:start": "node scripts/product.mjs start",
    "product:stop": "node scripts/product.mjs stop",
    "verify:product": "node scripts/verify-product.mjs",
    "build:dashboard": "node scripts/build-dashboard.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:security": "node scripts/verify-security.mjs",
    "verify:service": "node scripts/verify-service.mjs",
    "verify:candidate": "node scripts/verify-candidate.mjs",
    "verify:production": "node scripts/verify-production.mjs",
    "verify:images": "node scripts/verify-images.mjs",
    "product:doctor": "node scripts/product.mjs doctor",
    "product:backup": "node scripts/product.mjs backup",
    "package:release": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "@opentelemetry/api": "1.9.0",
    "@opentelemetry/sdk-trace": "2.12.0",
    "dotenv": "17.4.2",
    "express": "5.3.0",
    "lucide-react": "0.468.0",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.65.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.6"
  }
}
